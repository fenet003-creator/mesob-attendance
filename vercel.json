{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/signup", "dest": "/public/signup.html" },
    { "src": "/verify", "dest": "/public/verify.html" },
    { "src": "/dashboard", "dest": "/public/intern/dashboard.html" },
    { "src": "/admin/(.*)", "dest": "/public/admin/$1" },
    { "src": "/intern/(.*)", "dest": "/public/intern/$1" },
    { "src": "/supervisor/(.*)", "dest": "/public/supervisor/$1" },
    { "src": "/index.html", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
